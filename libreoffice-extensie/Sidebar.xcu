<?xml version="1.0" encoding="UTF-8"?>
<!-- Het zijpaneel "Assistent" in Writer, Calc en Impress: een eigen tabblad in de zijbalk. -->
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry" xmlns:xs="http://www.w3.org/2001/XMLSchema"
                    oor:name="Sidebar" oor:package="org.openoffice.Office.UI">
  <node oor:name="Content">
    <node oor:name="DeckList">
      <node oor:name="OfficeAssistentDeck" oor:op="replace">
        <prop oor:name="Title" oor:type="xs:string"><value xml:lang="nl">Assistent</value><value xml:lang="en-US">Assistant</value></prop>
        <prop oor:name="Id" oor:type="xs:string"><value>OfficeAssistentDeck</value></prop>
        <prop oor:name="IconURL" oor:type="xs:string"><value>vnd.sun.star.extension://nl.digitaalgemeengoed.office-assistent/icons/assistent.png</value></prop>
        <prop oor:name="HighContrastIconURL" oor:type="xs:string"><value>vnd.sun.star.extension://nl.digitaalgemeengoed.office-assistent/icons/assistent-hc.png</value></prop>
        <prop oor:name="ContextList"><value oor:separator=";">Writer, any, visible ;Calc, any, visible ;Impress, any, visible ;</value></prop>
        <prop oor:name="OrderIndex" oor:type="xs:int"><value>50</value></prop>
      </node>
    </node>
    <node oor:name="PanelList">
      <node oor:name="OfficeAssistentPaneel" oor:op="replace">
        <prop oor:name="Title" oor:type="xs:string"><value xml:lang="nl">Assistent</value><value xml:lang="en-US">Assistant</value></prop>
        <prop oor:name="TitleBarIsOptional" oor:type="xs:boolean"><value>true</value></prop>
        <prop oor:name="Id" oor:type="xs:string"><value>OfficeAssistentPaneel</value></prop>
        <prop oor:name="DeckId" oor:type="xs:string"><value>OfficeAssistentDeck</value></prop>
        <prop oor:name="ContextList"><value oor:separator=";">Writer, any, visible ;Calc, any, visible ;Impress, any, visible ;</value></prop>
        <prop oor:name="ImplementationURL" oor:type="xs:string"><value>private:resource/toolpanel/OfficeAssistentFabriek/Paneel</value></prop>
        <prop oor:name="OrderIndex" oor:type="xs:int"><value>100</value></prop>
      </node>
    </node>
  </node>
</oor:component-data>
