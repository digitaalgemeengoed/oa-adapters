<?xml version="1.0" encoding="UTF-8"?>
<!-- De fabriek die het zijpaneel maakt (assistent.py, PaneelFabriek). -->
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry" xmlns:xs="http://www.w3.org/2001/XMLSchema"
                    oor:name="Factories" oor:package="org.openoffice.Office.UI">
  <node oor:name="Registered">
    <node oor:name="UIElementFactories">
      <node oor:name="nl.digitaalgemeengoed.oa.Fabriek" oor:op="replace">
        <prop oor:name="Type"><value>toolpanel</value></prop>
        <prop oor:name="Name"><value>OfficeAssistentFabriek</value></prop>
        <prop oor:name="Module"><value/></prop>
        <prop oor:name="FactoryImplementation"><value>nl.digitaalgemeengoed.oa.PaneelFabriek</value></prop>
      </node>
    </node>
  </node>
</oor:component-data>
